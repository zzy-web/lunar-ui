{
  "name": "lunar-ui",
  "version": "0.1.0",
  "description": "A Vue 3 component library inspired by Element Plus.",
  "type": "module",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": ["**/*.css"],
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test:components": "npm run build:lib && node scripts/component-smoke.mjs",
    "site:build": "vite build --mode site",
    "dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:lib": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "build": "npm run build:lib && npm run docs:build",
    "prepack": "npm run build:lib",
    "prepublishOnly": "npm run typecheck && npm run test:components",
    "release": "npm publish"
  },
  "keywords": ["vue3", "component-library", "element-plus", "ui"],
  "author": "",
  "license": "MIT",
  "peerDependencies": { "vue": "^3.5.0" },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.9.2",
    "vite": "^5.4.19",
    "vitepress": "^1.6.4",
    "vue": "^3.5.21",
    "vue-tsc": "^2.2.12"
  }
}
