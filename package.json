{
  "name": "@your-scope/lunar-ui",
  "version": "0.1.0",
  "description": "A Vue 3 component library inspired by Element Plus.",
  "type": "module",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "site:build": "vite build --mode site",
    "dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "release": "npm run build && npm publish --access public"
  },
  "keywords": ["vue3", "component-library", "element-plus", "ui"],
  "author": "",
  "license": "MIT",
  "peerDependencies": { "vue": "^3.5.0" },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.9.2",
    "vite": "^5.4.19",
    "vitepress": "^1.6.4",
    "vue": "^3.5.21",
    "vue-tsc": "^2.2.12"
  }
}
